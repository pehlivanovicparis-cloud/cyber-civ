# Copy to /opt/cyberciv/rental.env on the server and fill in.
# NEVER commit the filled-in file — it holds secrets.

# --- rental server ---
RENTAL_ADMIN_TOKEN=YOUR_GENERATED_ADMIN_TOKEN_HERE
RENTAL_PROVIDER_KEY=YOUR_PROVIDER_API_KEY_HERE
RENTAL_PROVIDER_BASE_URL=https://api.openai.com/v1
RENTAL_MODEL=gpt-4o-mini
RENTAL_PORT=8765
RENTAL_RATE_LIMIT=30

# --- stripe webhook receiver ---
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE
RENTAL_ADMIN_URL=http://127.0.0.1:8765
# RENTAL_ADMIN_TOKEN is reused from above (same EnvironmentFile)
PRICE_STARTER=price_1UKhCUJfJcUBPvaAw6wFWkBz
PRICE_PRO=price_1UKhDAJfJcUBPvaAfnukFPsa
WEBHOOK_PORT=8766

# --- optional: email API keys to customers automatically ---
# Without these, new keys print to the webhook's stdout for manual delivery.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
