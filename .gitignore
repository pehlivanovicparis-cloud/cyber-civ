# Runtime state — regenerated on every run, never committed.
memory/
__pycache__/
*.pyc

# Web-grounded world-event feed — refreshed weekly by a scheduled research
# job, never committed (stale news in git history is noise).
world_events.jsonl

# secrets — never commit
.env
.env.*
*.key
*.pem
*.token
credentials*
secrets*

# Raw harvest records — kept locally, never committed (regenerable from runs).
training/harvest1/
training/harvest8b/
training/adapters/

# Tooling caches / local envs / training output — never committed.
.pytest_cache/
.venv/
venv/
training/output/
*.egg-info/
.DS_Store

# Submission video intermediates + showcase run outputs — local only.
recovery/video/audio/
recovery/video/slides/
recovery/video/seg*.mp4
recovery/video/concat.txt
showcase-2026-10-31/
showcase-2026-11-01/
showcase-2026-11-01-run2/
